# Copy to Backend/.env and fill in. Backend/.env is gitignored; never commit it.
# The real values for the team's Supabase project are shared privately.

# Required. Supabase project URL and service-role key
# (Supabase dashboard -> Project Settings -> API). server.py reads both at import
# time and fails with KeyError if either is missing.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role key>

# Recommended. Any long random string; it signs login tokens. Without it the server
# picks a random secret on every start, so each restart signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Optional. Comma-separated usernames that get the admin pages.
ADMIN_USERNAMES=admin

# Optional. 1 sends answer hints to the browser (demo only). Default 0.
DEMO_SHOW_ANSWERS=0

# Optional. Comma-separated allowed origins. Default * (any origin).
# CORS_ORIGINS=http://localhost:5173

# Optional. Verbose question-selection logging. Default true.
NEXT_QUESTION_DEBUG_LOGS=false
